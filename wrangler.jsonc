{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "benkku-me",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Static assets are served directly unless the Worker runs first.
    // The Worker is what applies the security headers, so it has to run.
    "run_worker_first": true
  }
}
